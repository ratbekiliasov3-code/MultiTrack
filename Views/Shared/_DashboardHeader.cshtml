@{
    string? username = ViewBag.Username as string;
    if (string.IsNullOrEmpty(username) && Model != null)
    {
        var prop = Model.GetType().GetProperty("Username");
        if (prop != null)
        {
            username = prop.GetValue(Model)?.ToString();
        }
    }
    if (string.IsNullOrEmpty(username))
    {
        username = "rad";
    }
}

<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #eef3fb;
    }
    .dashboard-topbar {
        background: linear-gradient(90deg, #081026 0%, #11213e 100%);
        color: white;
        padding: 24px 40px;
        border-radius: 0;
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.16);
        margin-bottom: 24px;
    }
    .dashboard-topbar__back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: rgba(255,255,255,0.88);
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.16);
        transition: background 0.2s, transform 0.2s;
        font-size: 14px;
        font-weight: 600;
    }
    .dashboard-topbar__back:hover {
        background: rgba(255,255,255,0.08);
        transform: translateY(-1px);
    }
    .dashboard-topbar__brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .dashboard-topbar__logo {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.6px;
    }
    .dashboard-topbar__logo span {
        color: #ffd23f;
    }
    .dashboard-topbar__subtitle {
        font-size: 14px;
        color: #c6d1ff;
        margin-top: 4px;
    }
    .dashboard-topbar__user {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .dashboard-topbar__user-text {
        text-align: right;
    }
    .dashboard-topbar__user-text span {
        display: block;
    }
    .dashboard-topbar__user-name {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
    }
    .dashboard-topbar__avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.18);
        background: linear-gradient(135deg, #26345e 0%, #102141 100%);
        box-shadow: inset 0 2px 6px rgba(255,255,255,0.08), 0 10px 30px rgba(0,0,0,0.15);
    }
    @@media (max-width: 768px) {
        .dashboard-topbar {
            flex-direction: column;
            align-items: flex-start;
        }
        .dashboard-topbar__user {
            width: 100%;
            justify-content: space-between;
        }
        .dashboard-topbar__user-text {
            text-align: left;
        }
    }
</style>

<div class="dashboard-topbar">
    <a class="dashboard-topbar__back" href="/Dashboard?user=@username" onclick="if (history.length > 1) { history.back(); return false; }">
        <span>&larr;</span> Geri Dön
    </a>
    <div class="dashboard-topbar__brand">
        <div class="dashboard-topbar__logo">Multi<span>Track</span></div>
    </div>
    <div class="dashboard-topbar__user">
        <div class="dashboard-topbar__user-text">
            <span>Hoş geldin,</span>
            <span class="dashboard-topbar__user-name">@username</span>
        </div>
        <div class="dashboard-topbar__avatar"></div>
    </div>
</div>
