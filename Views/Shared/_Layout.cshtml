<!DOCTYPE html>
<html lang="@LanguageHelper.GetCurrentLanguage(Context).ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MultiTrack</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Bootstrap CSS for premium UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-..." crossorigin="anonymous" />
</head>
<body>
    <header class="bg-primary text-white py-3 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0">MultiTrack</h1>
            <nav>
                <ul class="nav">
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">@LanguageHelper.T(Context, "Home")</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">@LanguageHelper.T(Context, "Dashboard")</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Dashboard" asp-action="KitapTakip">@LanguageHelper.T(Context, "BookTrack")</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Dashboard" asp-action="SuTakibi">@LanguageHelper.T(Context, "WaterTrack")</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Dashboard" asp-action="Istatistik">@LanguageHelper.T(Context, "Statistics")</a></li>
                    <li class="nav-item">@await Html.PartialAsync("_LanguageSelector")</li>
                </ul>
            </nav>
        </div>
    </header>
    <main role="main" class="container my-4">
        @RenderBody()
    </main>
    <footer class="bg-light text-center py-3 mt-auto">
        <p class="mb-0">&copy; 2024 - MultiTrack</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-..." crossorigin="anonymous"></script>
    <script src="~/js/site.js"></script>
</body>
</html>