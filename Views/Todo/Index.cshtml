@model List<MultiTrack.Models.TodoItem>

<h1>@LanguageHelper.T(Context, "TodoPageTitle")</h1>

<!-- FORM -->
<form asp-action="Add" method="post">
    <input type="text" name="title" placeholder="@LanguageHelper.T(Context, "NewTodoPlaceholder")" />
    <button type="submit">@LanguageHelper.T(Context, "AddButton")</button>
</form>

<hr />

<!-- LİSTE -->
<ul>
@foreach (var item in Model)
{
<li>
    @item.Title

    @if(item.IsDone)
    {
        <span>✅</span>
    }
    else
    {
        <span>❌</span>
    }

    <form asp-action="Delete" method="post" style="display:inline;">
        <input type="hidden" name="id" value="@item.Id" />
        <button type="submit">@LanguageHelper.T(Context, "DeleteButton")</button>
    </form>
</li>
}
</ul>