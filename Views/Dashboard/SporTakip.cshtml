@using MultiTrack.Models
@model DashboardSporTakipViewModel?
@{
    Layout = null; 
    string[] gunler = { "PAZARTESİ", "SALI", "ÇARŞAMBA", "PERŞEMBE", "CUMA", "CUMARTESİ" };
    string bugun = Model?.CurrentDayName ?? "PAZARTESİ";
    string bugunNorm = bugun.Replace('İ', 'I').Replace('ı', 'i');
    var liste = Model?.Workouts ?? new List<SporAntrenman>();
    int todayIndex = Model?.TodayDayIndex ?? 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    body { background-color: #f4f7f9; }
    .nav-link { color: #555; text-decoration: none; font-weight: bold; }
    .today-box { background: #2c3e50; color: white; padding: 20px; border-radius: 15px; margin: 20px 0; }
    .card { border-radius: 12px; border: none; box-shadow: 0 2px 5px rgba(0,0,0,0.1); margin-bottom: 20px; }
    .card-header { font-weight: bold; color: white; border-radius: 12px 12px 0 0 !important; padding: 10px; }
    .btn-action { font-size: 0.75rem; padding: 2px 8px; }
    .today-day { color: #212529 !important; }
</style>

<partial name="_DashboardHeader" />

<div class="container py-4">

  <div class="today-box">
    <h4>⚡ @LanguageHelper.T(Context, "TodayAt") @bugun</h4>
    
    @if (liste.Any(m => m.Gun.ToUpper() == bugun))
    {
        <div class="d-flex flex-wrap gap-2 mt-2">
            @foreach (var item in liste.Where(m => m.Gun.ToUpper() == bugun))
            {
                <span class="badge" style="background: #34495e; color: white; padding: 5px 15px; border-radius: 20px;">🔥 @item.AntrenmanAdi</span>
            }
        </div>
    }
    else
    {
        <p class="mb-0 mt-2">@LanguageHelper.T(Context, "NoWorkoutPlanMessage")</p>
    }
</div>


<div class="card shadow-sm p-4 mb-4" style="border-radius: 15px;">
    <div class="d-flex justify-content-between mb-2">
        <span class="fw-bold">@LanguageHelper.T(Context, "WeeklyCompletionTitle")</span>
        <span class="fw-bold">@(Model?.WeeklyCompletionRate ?? 0)%</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span>@LanguageHelper.T(Context, "TotalWorkoutsLabel")</span>
        <span>@(Model?.TotalWeeklyWorkouts ?? 0)</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span>@LanguageHelper.T(Context, "CompletedWorkoutsLabel")</span>
        <span>@(Model?.CompletedWeeklyWorkouts ?? 0)</span>
    </div>
    <div class="progress" style="height: 10px; border-radius: 5px;">
        <div class="progress-bar bg-success" role="progressbar" style="width: @(Model?.WeeklyCompletionRate ?? 0)%" aria-valuenow="@(Model?.WeeklyCompletionRate ?? 0)" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    <div class="row">
        @for (int i = 0; i < gunler.Length; i++)
        {
            var gun = gunler[i];
            string gunNorm = gun.Replace('İ', 'I').Replace('ı', 'i');
            bool isToday = string.Equals(gunNorm, bugunNorm, StringComparison.OrdinalIgnoreCase);
            <div class="col-md-6">
                <div class="card @(isToday ? "border border-warning" : "")">
                   <div class="card-header @(isToday ? "bg-warning text-dark today-day" : "bg-dark")">
    @gun
</div>
                    <div class="card-body">
                        <form action="/Dashboard/AntrenmanEkle" method="post" class="input-group mb-2">
                            <input type="hidden" name="gun" value="@gun">
                            <input type="hidden" name="user" value="@ViewBag.Username">
                            <input type="text" name="antrenmanAdi" class="form-control" placeholder="@LanguageHelper.T(Context, "AddPlanPlaceholder")" required>
                            <button type="submit" class="btn btn-dark">@LanguageHelper.T(Context, "AddWorkout")</button>
                        </form>
                        
                        <ul class="list-group">
    @foreach (var item in liste.Where(m => m.Gun.ToUpper() == gun))
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                @item.AntrenmanAdi
            </span>
            <div class="d-flex gap-1">
                <form action="/Dashboard/AntrenmanTamamla" method="post">
                    <input type="hidden" name="id" value="@item.Id">
                    <input type="hidden" name="user" value="@ViewBag.Username">
                    <button type="submit" class="btn btn-sm btn-success btn-action">✔</button>
                </form>
                <form action="/Dashboard/AntrenmanSil" method="post">
                    <input type="hidden" name="id" value="@item.Id">
                    <input type="hidden" name="user" value="@ViewBag.Username">
                    <button type="submit" class="btn btn-sm btn-danger btn-action">@LanguageHelper.T(Context, "DeleteButton")</button>
                </form>
            </div>
        </li>
    }
</ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>