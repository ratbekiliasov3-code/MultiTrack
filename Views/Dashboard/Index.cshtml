@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@LanguageHelper.GetCurrentLanguage(Context).ToLowerInvariant()">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@LanguageHelper.T(Context, "DashboardTitle")</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            margin: 0;
            background-color: #eef3fb;
            font-family: 'Helvetica Neue', Arial, sans-serif;
        }

        /* Üst Menü / Koyu Navbar Ayarları */
        .navbar {
            background-color: #112240;
            padding: 15px 40px;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: #ffd700;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
        }

        .profile-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #dcdcdc;
            object-fit: cover;
        }

        .welcome-text {
            font-size: 16px;
            font-weight: normal;
        }

        .welcome-text strong {
            font-weight: bold;
        }

        /* Dashboard Grid Yapısı */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
            padding: 40px 0;
        }

        /* Ortak Kart Ayarları */
        .dashboard-card {
            background-color: white;
            border-radius: 20px;
            height: 300px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px;
            background-size: cover;
            background-position: center;
        }

        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(255, 255, 255, 0.75);
            z-index: 1;
        }

        .card-content {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-header-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .card-title {
            font-size: 16px;
            font-weight: bold;
            color: #112240;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-meta {
            font-size: 14px;
            font-weight: bold;
            color: #112240;
        }

        /* Kartların Özel Arka Plan Görselleri */
        .card-su { background-image: url('https://images.unsplash.com/photo-1548839140-29a749e1cf4d?q=80&w=600'); }
        .card-istatistik { background-image: url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=600'); }
        .card-plan { background-image: url('https://images.unsplash.com/photo-1517842645767-c639042777db?q=80&w=600'); }
        .card-kitap { background-image: url('https://images.unsplash.com/photo-1506880018603-83d5b814b5a6?q=80&w=600'); }
        .card-spor { background-image: url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=600'); }
        
        .card-finans { background-image: none; background-color: #ffffff; }
        .card-finans::before { display: none; }

        /* Buton Stilleri */
        .btn-card {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 15px;
            border: none;
            transition: opacity 0.2s;
        }

        .btn-card:hover {
            opacity: 0.9;
        }

        .btn-blue { background-color: #4c8fe8; color: white; }
        .btn-dark-blue { background-color: #1a2b49; color: white; }
        .btn-orange { background-color: #f09b0a; color: white; }
        .btn-red { background-color: #ef4a4a; color: white; }

        /* Kitap Kartı İçeriği */
        .book-detail {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 15px;
        }

        .book-img {
            width: 45px;
            height: 60px;
            object-fit: cover;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .book-info h5 {
            font-size: 16px;
            font-weight: bold;
            margin: 0;
            color: #000;
        }

        .book-info p {
            font-size: 13px;
            color: #555;
            margin: 0;
        }

        .big-value {
            font-size: 32px;
            font-weight: bold;
            color: #2b5cb3;
            text-align: center;
            margin-top: 20px;
        }

        .center-desc {
            font-size: 14px;
            color: #333;
            text-align: center;
            font-weight: 500;
        }

        .placeholder-text {
            color: #7a869a;
            font-size: 15px;
            margin-top: 15px;
        }

        .finance-list {
            margin-top: 15px;
            font-size: 15px;
            color: #112240;
        }
        .finance-list div {
            margin-bottom: 4px;
        }

        @@media (max-width: 992px) {
            .dashboard-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @@media (max-width: 768px) {
            .dashboard-grid { grid-template-columns: 1fr; }
            .navbar { padding: 15px 20px; }
        }
    </style>
</head>
<body>

<nav class="navbar d-flex justify-content-between align-items-center">
    <div class="logo">
        Multi<span>Track</span>
    </div>
    <div class="user-profile">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100" alt="Profil" class="profile-img">
        <span class="welcome-text">@LanguageHelper.T(Context, "WelcomeLabel") <strong>@ViewBag.Username</strong></span>
    </div>
</nav>

<div class="container">
    <div class="dashboard-grid">

        <div class="dashboard-card card-su">
            <div class="card-content">
                <div>
                    <div class="card-header-area">
                        <div class="card-title"><i class="bi bi-droplet-fill text-primary"></i> @LanguageHelper.T(Context, "WaterCardTitle")</div>
                        <div class="card-meta">@LanguageHelper.T(Context, "WaterCardGoal")</div>
                    </div>
                    <div class="big-value">0.0 L / 3.0 L</div>
                </div>
                <a href="/Dashboard/SuTakip?user=@Context.Request.Query["user"]" class="btn btn-primary w-100" style="background-color: #4c8fe8; border: none; border-radius: 12px; padding: 10px;">
    @LanguageHelper.T(Context, "WaterCardLink")
</a>
            </div>
        </div>

        <div class="dashboard-card card-istatistik">
            <div class="card-content">
                <div>
                    <div class="card-header-area">
                        <div class="card-title"><i class="bi bi-bar-chart-line-fill text-primary"></i> @LanguageHelper.T(Context, "StatsCardTitle")</div>
                    </div>
                    <div class="mt-2 text-center">
                        <span class="font-weight-bold d-block text-dark fw-bold" style="font-size:15px;">@LanguageHelper.T(Context, "StatsCardDesc")</span>
                        <span class="center-desc d-block mt-1"></span>
                    </div>
                </div>
                <a href="/Dashboard/Istatistik?user=@ViewBag.Username" class="btn-card btn-blue text-center text-decoration-none">@LanguageHelper.T(Context, "StatsCardLink")</a>
            </div>
        </div>

        <div class="dashboard-card card-plan">
            <div class="card-content">
                <div>
                    <div class="card-header-area">
                        <div class="card-title"><i class="bi bi-sticky-fill text-warning"></i> @LanguageHelper.T(Context, "PlanCardTitle")</div>
                    </div>
                    <div class="placeholder-text">@LanguageHelper.T(Context, "PlanCardEmpty")</div>
                </div>
<a href="/Dashboard/GunlukPlan?user=@Context.Request.Query["user"]" class="btn-card btn-dark-blue text-center text-decoration-none">
    @LanguageHelper.T(Context, "PlanCardLink")
</a>
            </div>
        </div>

        <div class="dashboard-card card-kitap">
            <div class="card-content">
                <div>
                    <div class="card-header-area">
                        <div class="card-title"><i class="bi bi-book-half text-primary"></i> @LanguageHelper.T(Context, "BookCardTitle")</div>
                    </div>
                    <div class="book-detail">
                        <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?q=80&w=100" alt="Yazar" class="book-img">
                        <div class="book-info">
                            <h5>rrrrrr</h5>
                            <p>Cengiz Aytmatov</p>
                        </div>
                    </div>
                </div>
               <a href="/Dashboard/KitapTakip?user=@ViewBag.Username" class="btn btn-primary btn-card">@LanguageHelper.T(Context, "BookCardLink")</a>
            </div>
        </div>

        <div class="dashboard-card card-spor">
            <div class="card-content">
                <div>
                    <div class="card-header-area">
                        <div class="card-title"><i class="bi bi-capslock-fill text-primary"></i> @LanguageHelper.T(Context, "WorkoutCardTitle")</div>
                        <div class="card-meta">@LanguageHelper.T(Context, "WorkoutCardMeta")</div>
                    </div>
                    <div class="placeholder-text text-dark fw-medium mt-3">@LanguageHelper.T(Context, "WorkoutCardEmpty")</div>
                </div>
<a href="/Dashboard/SporTakip?user=@ViewBag.Username" 
   class="btn btn-primary" 
   style="width: 100%; padding: 12px; border-radius: 12px; font-weight: bold; background-color: #0d6efd; border: none;">
   @LanguageHelper.T(Context, "WorkoutCardLink")
</a>
            </div>
        </div>

        <div class="dashboard-card card-finans">
            <div class="card-content">
                <div>
                    <div class="card-header-area">
                        <div class="card-title"><i class="bi bi-wallet2 text-primary"></i> @LanguageHelper.T(Context, "ExpenseCardTitle")</div>
                    </div>
                    <div class="finance-list">
                    <div>@LanguageHelper.T(Context, "ExpenseCardTotalToday") <strong>@(ViewBag.TodayExpenseTotal is double t ? t.ToString("0.00") : "0.00") ₺</strong></div>
                    <div>@LanguageHelper.T(Context, "ExpenseCardTotalMonth") <strong>@(ViewBag.MonthlyExpenseTotal is double m ? m.ToString("0.00") : "0.00") ₺</strong></div>
                </div>
            </div>
                <a href="/Dashboard/ParaTakip?user=@ViewBag.Username" class="btn-card btn-red text-center text-decoration-none">@LanguageHelper.T(Context, "ExpenseCardLink")</a>
        </div>

    </div>
</div>

</body>
</html>